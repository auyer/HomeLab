    cp-backend:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "http://10.255.2.6:3923"

    draw-backend:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "http://10.255.2.37:3000"

    ender-backend:
