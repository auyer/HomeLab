          - url: "http://10.255.2.53:80"

    noop:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:9"

  middlewares:
    https-redirect:
      redirectScheme:
        scheme: https
        permanent: true

  serversTransports:
    cloud-insecure:
      insecureSkipVerify: true
