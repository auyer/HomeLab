        passHostHeader: true
        servers:
          - url: "http://10.255.2.29:80"

    pihole2-backend:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "http://10.255.0.101:8080"

    stream-backend:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "http://10.255.2.156:4533"

    transmission-backend:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "http://10.255.1.54:9091"


    k-nodes:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "http://10.255.2.51:80"
