    hg-backend:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "http://10.255.2.29:3000"

    immich-backend:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "http://10.255.1.67:80"

    ma-backend:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "http://172.16.88.102:8095"

    matrix-backend:
