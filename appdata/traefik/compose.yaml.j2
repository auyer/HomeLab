# docker-compose.yaml
services:
  traefik:
    image: traefik:v3.7
    network_mode: host
    environment:
      - CF_DNS_API_TOKEN={{acme_cloudflare_api_token}}
    volumes:
      - traefik-acme:/letsencrypt
      - ./traefik.yaml:/etc/traefik/traefik.yaml:ro
      - ./dynamic.yaml:/etc/traefik/dynamic.yaml:ro
    command:
      - "--configFile=/etc/traefik/traefik.yaml"
    logging:
      driver: "json-file"
      options:
        max-size: "500m"
        max-file: "2"

volumes:
  traefik-acme:
