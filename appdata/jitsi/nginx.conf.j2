{% if alternative_domain_names %}
load_module modules/ngx_http_acme_module.so;
{% endif %}

user  nginx;
worker_processes  auto;

error_log  /var/log/nginx/error.log notice;
pid        /var/run/nginx.pid;

events {
    worker_connections 1024;
}


http {
    server_tokens off;

{% if alternative_domain_names %}
    # ngx_http_acme_module needs a DNS resolver to reach the cert
    # cert authority when issuing/renewing certificates.
    resolver {{ nginx_resolver | default('127.0.0.11') }} valid=30s ipv6=off;
{% endif %}

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Jitsi web listens on 8000 (HTTP) and 8443 (HTTPS)
    upstream web_http {
        server web:8000 fail_timeout=1s;
        keepalive 1;
    }

    upstream web_https {
        server web:8443 fail_timeout=1s;
        keepalive 1;
    }

    upstream anubis {
        server anubis:8080 fail_timeout=1s;
    }

{% if alternative_domain_names %}
    # Native ACME for the ADDITIONAL hostnames only.
    # The primary domain keeps the certificate generated
    # by Jitsi's embedded nginx/acme.sh (see below).
    
    acme_issuer letsencrypt {
        uri         {{ acme_directory_url | default('https://acme-v02.api.letsencrypt.org/directory') }};
{% if acme_address %}
        contact     mailto:{{ acme_address }};
{% endif %}
        state_path  /var/cache/nginx/acme;
        accept_terms_of_service;
    }

    # In-memory storage for issued certificates, keys and challenge data.
    acme_shared_zone zone=acme_shared:1M;
{% endif %}

    # HTTP -> straight to the web container (ACME + HTTPS redirect handled there)
    # For the alternative domains, ngx_http_acme_module intercepts
    # /.well-known/acme-challenge/ in the rewrite phase, before this proxy.
    server {
        listen 80;
        # listen [::]:80;

        server_name {{ domain_name }}{% if alternative_domain_names %} {{ alternative_domain_names | join(' ') }}{% endif %};

        location / {
            proxy_pass http://web_http;
            proxy_redirect off;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            # Always present the backend with the canonical domain, even when
            # the request arrived via an alternative_domain_names hostname.
            proxy_set_header Host              {{ domain_name }};
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host  {{ domain_name }};
        }
    }

{% set https_locations %}
        # Shared proxy settings, inherited by every location below.
        proxy_http_version 1.1;
        proxy_redirect off;
        # Always present the backend with the canonical domain, even when the
        # request arrived via an alternative_domain_names hostname.
        proxy_set_header Host              {{ domain_name }};
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  {{ domain_name }};
        # Was $ssl_server_name, which is domain_name for the primary block but
        # the alias for the alternative block; pin it to the canonical domain
        # so no alternative name leaks downstream.
        proxy_set_header X-TLS-SNI-Name    {{ domain_name }};
        proxy_set_header Connection        "";

        # Anubis internals (challenge page + assets) — must pass through.
        location ^~ /.within.website/          { proxy_pass http://anubis; }

        # Jitsi application files.
        location ~* \.js$                      { proxy_pass http://anubis; }
        location ~* \.css$                     { proxy_pass http://anubis; }
        location = /favicon.ico                { proxy_pass http://anubis; }
        location = /robots.txt                 { proxy_pass http://anubis; }
        location = /manifest.json              { proxy_pass http://anubis; }

        # Jitsi static assets (js, css, fonts, images, language files, ...).
        location ^~ /libs/                     { proxy_pass http://anubis; }
        location ^~ /css/                      { proxy_pass http://anubis; }
        location ^~ /static/                   { proxy_pass http://anubis; }
        location ^~ /images/                   { proxy_pass http://anubis; }
        location ^~ /fonts/                    { proxy_pass http://anubis; }
        location ^~ /lang/                     { proxy_pass http://anubis; }
        location ^~ /sounds/                   { proxy_pass http://anubis; }
        location ^~ /connection_optimization/  { proxy_pass http://anubis; }
        location ^~ /transcripts/              { proxy_pass http://anubis; }
        location ^~ /.well-known/              { proxy_pass http://anubis; }

        # Signaling (chat): XMPP websocket + BOSH fallback.
        # The websocket bypasses Anubis (it can't proxy upgraded connections) and
        # goes straight to the web container's HTTPS listener.
        location = /xmpp-websocket {
            proxy_pass https://web_https;
            proxy_ssl_verify off;
            proxy_set_header Upgrade    $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }
        location = /http-bind                  { proxy_pass http://anubis; }

        # allowed rooms.
{% for room in allowed_rooms %}
        location = /{{ room }}                 { proxy_pass http://anubis; }
{% endfor %}

        # Everything else (bare /, any other room) -> redirect into the room.
        # (only if rooms are defined)
{% if allowed_rooms %}
{% if redirect_to %}
        location /                             { return 301 {{ redirect_to }}; }
{% else %}
        location /                             { return 404; }
{% endif %}
{% endif %}
{% endset %}

    # HTTPS -> terminate TLS for the primary domain with the web container's
    # certs, filter via Anubis, and lock the instance down with the configured rooms
    #
    # NOTE: HTTP (port 80) is intentionally left as a pure passthrough above so
    # ACME HTTP-01 challenges and the HTTP->HTTPS redirect keep working.
    server {
        listen 443 ssl;
        # listen [::]:443 ssl;
        http2 on;

        server_name {{ domain_name }};

        # The ensure-acme-cert.sh entrypoint hook guarantees the files exist before ACME runs
        # (self-signed placeholder on first boot, until ACME generates its cert);
        
        ssl_certificate     /etc/nginx/certs/acme-certs/{{ domain_name }}/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/acme-certs/{{ domain_name }}/key.pem;

        ssl_protocols TLSv1.2 TLSv1.3;

{{ https_locations }}
    }

{% if alternative_domain_names %}
    # HTTPS -> additional domains, terminated with certificates issued and
    # renewed by ngx_http_acme_module (see acme_issuer above).

    server {
        listen 443 ssl;
        # listen [::]:443 ssl;
        http2 on;

        server_name {{ alternative_domain_names | join(' ') }};
        acme_certificate letsencrypt;

        # Populated by the ACME module

        ssl_certificate       $acme_certificate;
        ssl_certificate_key   $acme_certificate_key;

        # Do not parse the cert/key on every TLS handshake.
        ssl_certificate_cache max=2;

        ssl_protocols TLSv1.2 TLSv1.3;

{{ https_locations }}
    }
{% endif %}

    # Jitsi needs large uploads and long-lived connections
    client_max_body_size 0;
    client_header_timeout 610m;
    client_body_timeout 610m;
    send_timeout 610m;
}
