#!/bin/sh
#
# upssched-cmd — optional override for the Debian-packaged stub of the same
# name (shipped by nut-client). Only deployed when nut_upssched_enabled and
# nut_upssched_cmd_custom are both true.
#
# upssched calls this with the timer name from the matching AT ... START-TIMER
# line in upssched.conf. Keep this script's case labels in sync with
# nut_upssched_timers in the role defaults.
#
# Managed by Ansible (role: nut).

case "$1" in
  onbattwarn)
    logger -t nut-upssched "UPS on battery for 60s - check power"
    wall "UPS is on battery power." 2>/dev/null || true
    ;;
  upsgone)
    logger -t nut-upssched "Lost communication with UPS"
    ;;
  *)
    logger -t nut-upssched "Unrecognized upssched event: $1"
    ;;
esac
