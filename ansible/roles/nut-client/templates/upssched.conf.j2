# Network UPS Tools - upssched.conf — NUT netclient
#
# Generated by the nut-client role.
#
# upssched is the helper that lets upsmon delay and debounce reactions to UPS
# events: instead of acting on every ONBATT/COMMBAD notification (power blips
# included), it arms a timer and only fires if the condition persists.
#
# Requirements for this to work at all:
#   * upsmon must call upssched: NOTIFYCMD points at the upssched binary and
#     the relevant event types carry the EXEC flag (see upsmon.conf, which this
#     role derives from the AT rules below).
#   * PIPEFN and LOCKFN must be in a directory writable by the user upsmon
#     drops to (RUN_AS_USER), which this role creates and owns.

# ============================================================================
# CMDSCRIPT <scriptname>
#
# This script gets called to invoke commands for timers that trigger.
# It is given a single argument - the <timername> in your
# AT ... START-TIMER defines.
#
# *** This must be defined *before* the first AT line.  Otherwise the
#     program will complain and exit without doing anything.
CMDSCRIPT {{ nut_client_upssched_cmdscript }}

# ============================================================================
# PIPEFN <filename>
#
# This sets the file name of the FIFO that will pass communications between
# processes to start and stop timers.  This should be set to some path where
# normal users can't create the file, due to the possibility of symlinking
# and other evil.
#
# Note: by default, upsmon will run upssched as whatever user you have
# defined with RUN_AS_USER in upsmon.conf.  Make sure that user can
# create files and write to files in the path you use for PIPEFN and
# LOCKFN.
PIPEFN {{ nut_client_upssched_pipefn }}

# ============================================================================
# LOCKFN <filename>
#
# REQUIRED.  upssched needs to be able to create this filename in order to
# avoid a race condition when two events are dispatched from upsmon at nearly
# the same time.  This file will only exist briefly.
LOCKFN {{ nut_client_upssched_lockfn }}

# ============================================================================
# AT <notifytype> <upsname> <command>
#
# Define a handler for a specific event <notifytype> on UPS <upsname>.
# <upsname> can be the special value * to apply this handler to every
# possible value of <upsname>.
#
# <command> is one of:
#   START-TIMER <timername> <interval>   arm a timer that fires <interval>s later
#   CANCEL-TIMER <timername>             stop a running timer
#   EXECUTE <command>                    pass <command> to CMDSCRIPT immediately
{% for t in nut_client_upssched_timers %}
AT {{ t.type }} {{ t.ups | default('*') }} START-TIMER {{ t.timer }} {{ t.interval }}
{% if t.cancel_type | default('') | length > 0 %}
# If the condition clears, stop the countdown instead of firing late.
AT {{ t.cancel_type }} {{ t.ups | default('*') }} CANCEL-TIMER {{ t.timer }}
{% endif %}
{% endfor %}
