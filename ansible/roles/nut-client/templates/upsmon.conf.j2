# Network UPS Tools: upsmon configuration — NUT netclient
#
# Generated by the nut-client role. This host monitors a *remote* NUT server
# and shuts itself down when that server tells it the UPS is critical.
#
# This file contains passwords, so keep it secure.

{% set upssched_on = nut_client_upssched_enabled | bool %}
{# upsmon accepts exactly one NOTIFYCMD. An explicit value wins; otherwise, if
   upssched is enabled, upsmon itself is the upssched client and must point at
   the binary so AT timers get scheduled. #}
{% set notifycmd_resolved = nut_client_notifycmd if nut_client_notifycmd | length > 0 else (nut_client_upssched_bin if upssched_on else '') %}
{% set notifycmd_active = notifycmd_resolved | length > 0 %}
{# EXEC-flagged types: whatever the caller asked for, plus every type that has
   an AT rule, because upssched only learns about events via an EXEC flag. #}
{% set timer_types = nut_client_upssched_timers | map(attribute='type') | list if upssched_on else [] %}
{% set notify_exec_types = ((nut_client_notifyflags | list) + timer_types) | unique | list %}

# --------------------------------------------------------------------------
# RUN_AS_USER <userid>
#
# By default, upsmon splits into two processes.  One stays as root and
# waits to run the SHUTDOWNCMD.  The other one switches to another userid
# and does everything else.
#
# Note: if you plan to use the reload feature, this file (upsmon.conf)
# must be readable by this user!  Since it contains passwords, DO NOT
# make it world-readable.  Also, do not make it writable by the upsmon
# user, since it creates an opportunity for an attack by changing the
# SHUTDOWNCMD to something malicious.
#
# (Unprivileged) OS account to run as:
RUN_AS_USER {{ nut_client_runasuser }}

# --------------------------------------------------------------------------
# MONITOR <system> <powervalue> <username> <password> ("primary"|"secondary")
#
# <system> is a UPS identifier in the form <upsname>@<hostname>[:<port>].
# <powervalue> is the number of power supplies this UPS feeds on this system.
# <username> and <password> must match an entry in that server's upsd.users.
#
# "secondary" means this system shuts down immediately when power goes
# critical and less than MINSUPPLIES power sources have reliable input feeds.
# The primary (the host with the UPS cable) shuts down last; we do not wait to
# be told twice, and we do not need to talk to the UPS ourselves.
MONITOR {{ nut_client_monitor_ups }} {{ nut_client_monitor_powervalue }} {{ nut_client_monitor_user }} {{ nut_client_monitor_password }} {{ nut_client_monitor_role }}

# --------------------------------------------------------------------------
# MINSUPPLIES <num>
#
# Give the number of power supplies that must be receiving power to keep
# this system running.
MINSUPPLIES {{ nut_client_minsupplies }}

# --------------------------------------------------------------------------
# SHUTDOWNCMD "<command>"
#
# upsmon runs this command when the system needs to be brought down.
#
# Note that while you experiment with the initial setup and want to test how
# your configuration reacts to power state changes and ultimately when power
# is reported to go critical, but do not want your system to actually turn
# off, consider setting the SHUTDOWNCMD temporarily to do something benign -
# such as posting a message with 'logger' or 'wall'.
SHUTDOWNCMD "{{ nut_client_shutdowncmd }}"

# --------------------------------------------------------------------------
# SHUTDOWNEXIT <boolean|num>
#
# After initiating shutdown, should this upsmon daemon itself exit?
# By doing so NUT secondary systems can tell the NUT primary that
# it can proceed with its own shutdown and eventually tell the UPS
# to cut power for the load. ("Yes" by default)
#
#SHUTDOWNEXIT yes

{% if notifycmd_active %}
# --------------------------------------------------------------------------
# NOTIFYCMD <command>
#
# upsmon calls this to send messages when things happen. It is called with the
# full text of the message as one argument, with NOTIFYTYPE and UPSNAME in the
# environment. Only event types flagged with EXEC below invoke it.
NOTIFYCMD {{ notifycmd_resolved }}
{% else %}
# --------------------------------------------------------------------------
# NOTIFYCMD is not set: this host keeps the default syslog+wall notification
# behaviour. Set nut_client_notifycmd to run a program on events.
{% endif %}

# --------------------------------------------------------------------------
# POLLFREQ <n>
#
# Polling frequency for normal activities, measured in seconds.
POLLFREQ {{ nut_client_pollfreq }}

# --------------------------------------------------------------------------
# POLLFREQALERT <n>
#
# Polling frequency in seconds while UPS on battery.
POLLFREQALERT {{ nut_client_pollfreqalert }}

# --------------------------------------------------------------------------
# HOSTSYNC - How long upsmon will wait before giving up on another upsmon
#
# The primary upsmon process uses this number when waiting for secondary
# systems to disconnect once it has set the forced shutdown (FSD) flag.
# Similarly, upsmon secondary processes wait up to this interval for the
# primary upsmon to set FSD when an UPS they are monitoring goes critical.
HOSTSYNC {{ nut_client_hostsync }}

# --------------------------------------------------------------------------
# DEADTIME - Interval to wait before declaring a stale ups "dead"
#
# A dead UPS that was last known to be on battery is assumed to have gone
# to a low battery condition. This may force a shutdown if it is providing
# a critical amount of power to your system.
#
# Note: DEADTIME should be a multiple of POLLFREQ and POLLFREQALERT.
DEADTIME {{ nut_client_deadtime }}

# --------------------------------------------------------------------------
# POWERDOWNFLAG - Flag file for forcing UPS shutdown on the primary system
#
# Only meaningful on a primary; kept for parity with the packaged file.
POWERDOWNFLAG "{{ nut_client_powerdownflag }}"

# --------------------------------------------------------------------------
# NOTIFYFLAG - change behavior of upsmon when NOTIFY events occur
#
# Possible values for the flags:
#
# SYSLOG - Write the message in the syslog
# WALL   - Write the message to all users on the system
# EXEC   - Execute NOTIFYCMD (see above) with the message
# IGNORE - Don't do anything
#
# With no EXEC-flagged types this host logs and walls events, which is the
# stock behaviour.
{% if notify_exec_types %}
{% for type in notify_exec_types %}
NOTIFYFLAG {{ type }} {{ nut_client_notifyflag_base }}+EXEC
{% endfor %}
{% else %}
# No event types are flagged for EXEC, so NOTIFYCMD (if any) is never invoked.
{% endif %}

# --------------------------------------------------------------------------
# OFFDURATION - put "OFF" state into effect if it persists for this many seconds
#
# When some devices begin battery calibration, they report "OFF" for a few
# seconds and only then might report "CAL", which would cause false-positive
# FSD triggers. This delays propagation of an administrative OFF state.
OFFDURATION {{ nut_client_offduration }}

# --------------------------------------------------------------------------
# RBWARNTIME - replace battery warning time in seconds
#
# upsmon warns about a battery that needs replacing every 43200 seconds
# (12 hours) by triggering NOTIFY_REPLBATT.
RBWARNTIME {{ nut_client_rbwarntime }}

# --------------------------------------------------------------------------
# NOCOMMWARNTIME - no communications warning time in seconds
#
# upsmon will let you know through the usual notify system if it can't
# talk to any of the UPS entries that are defined in this file.
NOCOMMWARNTIME {{ nut_client_nocommwarntime }}

# --------------------------------------------------------------------------
# FINALDELAY - last sleep interval before shutting down the system
#
# On a secondary this is the delay between NOTIFY_SHUTDOWN and SHUTDOWNCMD.
# Keep it below the primary's HOSTSYNC, or the primary stops waiting for this
# host to disconnect and carries on without it.
FINALDELAY {{ nut_client_finaldelay }}

{% if nut_client_debug_min %}
# --------------------------------------------------------------------------
# DEBUG_MIN - specify minimal debugging level for upsmon daemon
DEBUG_MIN {{ nut_client_debug_min }}
{% endif %}

# --------------------------------------------------------------------------
# Certificate options (CERTPATH / CERTIDENT / CERTHOST / CERTVERIFY /
# FORCESSL) are not configured here. Credentials to the monitoring account
# travel unencrypted unless SSL is set up on both ends; see the role README.
