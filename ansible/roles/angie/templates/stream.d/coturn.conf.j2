# start coturn (STUN/TURN)

upstream coturn_stun {
   	server {{ coturn_backend | default('10.255.2.28') }}:3478;
}

server {
	listen 3478;
	proxy_pass coturn_stun;
}

server {
	listen 3478 udp;
	proxy_pass coturn_stun;
	proxy_timeout 30s;
}

upstream coturn_stun_tls {
   	server {{ coturn_backend | default('10.255.2.28') }}:5349;
}

server {
	listen 5349 ssl;
	proxy_pass coturn_stun_tls;
	ssl_certificate "{{ coturn_ssl_certificate | default('/etc/letsencrypt/live/chat.rcpassos.me/fullchain.pem') }}";
	ssl_certificate_key "{{ coturn_ssl_certificate_key | default('/etc/letsencrypt/live/chat.rcpassos.me/privkey.pem') }}";
	ssl_certificate_cache max=1000 inactive=20s valid=1m;
}

# DTLS (UDP+TLS) is proxied directly to coturn — Angie cannot terminate DTLS.
# Port-forward UDP 5349 on your router directly to the coturn server.

# end coturn
