resource "proxmox_lxc" "uptime-kuma" {
  target_node  = var.proxmox_node
  vmid         = 300
  hostname     = "uptime-kuma"
  ostemplate   = data.external.debian_template.result.path
  unprivileged = true
  onboot       = true
  start        = true

  cores  = 1
  memory = 1024
  swap   = 512

  ssh_public_keys = var.ssh_key

  rootfs {
    storage = "loval-lvm"
    size    = "8G"
  }

  network {
    name     = "eth0"
    bridge   = var.nic_name
    ip       = "10.255.2.230/22"
    gw       = "10.255.0.1"
    firewall = true
  }

  features {
    nesting = true
  }

}
