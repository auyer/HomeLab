# start prosody
upstream prosody_xmpp {
   	server {{ prosody_backend | default('10.255.2.27') }}:5222;
}

server {
	listen 5222; # Listen for incoming client connections
	# listen 5222 ssl; # Listen for incoming client connections
	proxy_pass prosody_xmpp;
	# proxy_protocol on;
	ssl_certificate "/etc/letsencrypt/live/chat.rcpassos.me/fullchain.pem";
        ssl_certificate_key "/etc/letsencrypt/live/chat.rcpassos.me/privkey.pem";
	ssl_certificate_cache max=1000 inactive=20s valid=1m;
}

upstream prosody_s2s {
   server {{ prosody_backend | default('10.255.2.27') }}:5269;
}

server {
	listen 5269;
	proxy_pass prosody_s2s;
	# proxy_protocol on;
	ssl_certificate "/etc/letsencrypt/live/chat.rcpassos.me/fullchain.pem";
        ssl_certificate_key "/etc/letsencrypt/live/chat.rcpassos.me/privkey.pem";
	ssl_certificate_cache max=1000 inactive=20s valid=1m;
}


upstream prosody_files {
   server {{ prosody_backend | default('10.255.2.27') }}:5000;
}

server {
	listen 5000;
	proxy_pass prosody_files;
	# proxy_protocol on;
	ssl_certificate "/etc/letsencrypt/live/chat.rcpassos.me/fullchain.pem";
        ssl_certificate_key "/etc/letsencrypt/live/chat.rcpassos.me/privkey.pem";
	ssl_certificate_cache max=1000 inactive=20s valid=1m;
	}
# end prosody
